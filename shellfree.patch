+        # Scrim must cover the output it lands on (DP-7, 4K). GTK's primary
+        # monitor geometry is 1536x960, which left a partial grey slab; and
+        # layer-shell zero-size fills don't work with GTK4-layer-shell. So
+        # size it to the largest monitor instead.
+        size_w = size_h = 0
+        display = Gdk.Display.get_default()
+        if display is not None:
+            monitors = display.get_monitors()
+            for i in range(monitors.get_n_items() if monitors else 0):
+                g = monitors.get_item(i).get_geometry()
